# =============================================================================
# ALAVI Destinos & Experiencias - variaveis de ambiente
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA versione .env.local no Git.
# =============================================================================

# URL publica do site (usada em SEO, sitemap, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=https://alavidestinos.com.br

# --- Contato / WhatsApp -----------------------------------------------------
# Numero de WhatsApp Business em formato internacional, somente digitos
# (54) 99231-2943 -> 5554992312943
NEXT_PUBLIC_WHATSAPP_NUMBER=5554992312943

# E-mail comercial exibido no site
NEXT_PUBLIC_CONTACT_EMAIL=alavidestinos@gmail.com

# Instagram (apenas o @, sem URL completa)
NEXT_PUBLIC_INSTAGRAM_HANDLE=alavi.destinos

# --- Formulario de orcamento -------------------------------------------------
# Envio direto por e-mail (SMTP). Se as 3 variaveis abaixo estiverem
# preenchidas, o formulario envia um e-mail diretamente para
# ORCAMENTO_EMAIL_TO a cada pedido — este e o caminho recomendado.
#
# Com Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=seu email
# @gmail.com, e SMTP_PASSWORD=uma "Senha de app" (NAO a senha normal da
# conta). Para gerar: ative a verificacao em duas etapas na Conta Google
# em myaccount.google.com/security e depois crie a senha de app em
# myaccount.google.com/apppasswords.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# E-mail que recebe os pedidos de orcamento. Se vazio, usa o proprio
# SMTP_USER como destinatario.
ORCAMENTO_EMAIL_TO=alavidestinos@gmail.com

# Alternativa/fallback: webhook (Make/Zapier, Formspree, Basin, ou
# futuramente o endpoint do CRM interno da ALAVI). Usado apenas se o SMTP
# acima nao estiver configurado, ou como reforco se o envio de e-mail falhar.
ORCAMENTO_WEBHOOK_URL=

# Token opcional de autenticacao do webhook acima (enviado como Bearer token)
ORCAMENTO_WEBHOOK_TOKEN=

# Se nenhum dos dois (SMTP ou webhook) estiver configurado, o formulario
# direciona o cliente para continuar o pedido direto pelo WhatsApp.

# --- Analytics (opcionais, nao inventar valores) ----------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
